# Ollama 설정
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Stable Diffusion WebUI 설정
SD_HOST=localhost
SD_PORT=7860

# Flask 서버 설정
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# 파일 업로드 설정
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# 보안 설정 (프로덕션에서만 사용)
# SECRET_KEY=your-secret-key-here

# 로깅 설정
# LOG_LEVEL=INFO
# LOG_FILE=app.log